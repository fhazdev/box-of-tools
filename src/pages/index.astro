---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, CATEGORY_ORDER } from '../data/tools';
---

<BaseLayout
  title="Box of Tools"
  description="Free, fast online utility tools: password generator and more. No signup required."
>
  <section class="mb-8">
    <h1 class="mb-2 text-2xl font-bold text-slate-900 dark:text-slate-100">Box of Tools</h1>
    <p class="max-w-2xl text-slate-600 dark:text-slate-400">
      A collection of small, fast, free utilities. Everything runs in your browser. Nothing you
      type is sent to a server.
    </p>
  </section>

  {
    CATEGORY_ORDER.map((category) => {
      const categoryTools = tools.filter((tool) => tool.category === category);
      if (categoryTools.length === 0) return null;

      return (
        <section class="mb-8">
          <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-slate-100">{category}</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {categoryTools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        </section>
      );
    })
  }
</BaseLayout>

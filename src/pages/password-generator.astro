---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordGenerator from '../components/tools/PasswordGenerator.svelte';
---

<BaseLayout
  title="Password Generator"
  description="Generate strong, random passwords and memorable passphrases in your browser. Configurable length, character sets, and word count — nothing is sent to a server."
>
  <h1 class="mb-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
    Secure Password Generator
  </h1>
  <p class="mb-6 flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z"
        clip-rule="evenodd"></path>
    </svg>
    Runs entirely in your browser. No data is ever transmitted to our servers.
  </p>

  <PasswordGenerator client:load />

  <section class="mt-10 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
    <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-slate-100">
      About this tool
    </h2>
    <p class="mb-2">
      Passwords are generated with the browser's cryptographically secure random number generator
      (<code>crypto.getRandomValues</code>). Use the <strong>Password</strong> tab for maximum
      strength in the fewest characters, or the <strong>Passphrase</strong> tab for passwords that
      are easier to remember and type — words are drawn from the EFF short wordlist (1,296 words).
    </p>
    <p>
      The strength meter estimates entropy in bits: roughly, each additional bit doubles the number
      of guesses an attacker would need. Aim for 60+ bits for ordinary accounts and 100+ bits for
      anything critical.
    </p>
  </section>
</BaseLayout>

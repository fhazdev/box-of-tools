---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <div class="py-16 text-center">
    <h1 class="mb-2 text-3xl font-bold text-slate-900 dark:text-slate-100">404</h1>
    <p class="mb-6 text-slate-600 dark:text-slate-400">Sorry, that page doesn't exist.</p>
    <a href="/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">
      ← Back to the toolbox
    </a>
  </div>
</BaseLayout>

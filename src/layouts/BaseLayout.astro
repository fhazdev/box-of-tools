---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { tools, CATEGORY_ORDER } from '../data/tools';

const currentPath = Astro.url.pathname;

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5815364143606523"
      crossorigin="anonymous"
      is:inline></script>
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme. Explicit choice
      // (localStorage) wins; otherwise fall back to the OS preference.
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-200"
  >
    <header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a
          href="/"
          class="text-lg font-bold text-slate-900 hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-400"
        >
          🧰 Box of Tools
        </a>
        <div class="relative flex items-center gap-4">
          <button
            id="tools-menu-button"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="tools-menu"
            class="flex items-center gap-1.5 rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path
                d="M4.25 2A2.25 2.25 0 0 0 2 4.25v2.5A2.25 2.25 0 0 0 4.25 9h2.5A2.25 2.25 0 0 0 9 6.75v-2.5A2.25 2.25 0 0 0 6.75 2h-2.5Zm9 0A2.25 2.25 0 0 0 11 4.25v2.5A2.25 2.25 0 0 0 13.25 9h2.5A2.25 2.25 0 0 0 18 6.75v-2.5A2.25 2.25 0 0 0 15.75 2h-2.5Zm-9 9A2.25 2.25 0 0 0 2 13.25v2.5A2.25 2.25 0 0 0 4.25 18h2.5A2.25 2.25 0 0 0 9 15.75v-2.5A2.25 2.25 0 0 0 6.75 11h-2.5Zm9 0A2.25 2.25 0 0 0 11 13.25v2.5A2.25 2.25 0 0 0 13.25 18h2.5A2.25 2.25 0 0 0 18 15.75v-2.5A2.25 2.25 0 0 0 15.75 11h-2.5Z"
              ></path>
            </svg>
            All Tools
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </button>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5 dark:hidden"
              aria-hidden="true"
            >
              <path
                d="M17.293 13.293A8 8 0 0 1 6.707 2.707a8.001 8.001 0 1 0 10.586 10.586Z"
              ></path>
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="hidden h-5 w-5 dark:block"
              aria-hidden="true"
            >
              <path
                d="M10 2a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm4 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm-1.05-5.657a1 1 0 0 1 1.414 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707Zm-8.486 8.486a1 1 0 0 1 1.414 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707ZM17 9a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1ZM4 9a1 1 0 1 1 0 2H3a1 1 0 0 1 0-2h1Zm9.657 5.243a1 1 0 0 1 1.414 0l.707.707a1 1 0 0 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414ZM4.929 4.929a1 1 0 0 1 1.414 0l.707.707A1 1 0 1 1 5.636 7.05l-.707-.707a1 1 0 0 1 0-1.414ZM10 16a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1Z"
              ></path>
            </svg>
          </button>
          <div
            id="tools-menu"
            role="menu"
            class="hidden absolute right-0 top-full z-20 mt-2 w-[min(calc(100vw-2rem),40rem)] rounded-lg border border-slate-200 bg-white p-5 shadow-lg dark:border-slate-700 dark:bg-slate-900"
          >
            <a
              href="/"
              class={`mb-4 inline-block text-sm font-semibold ${
                currentPath === '/'
                  ? 'text-blue-700 dark:text-blue-400'
                  : 'text-slate-900 hover:text-blue-700 dark:text-slate-100 dark:hover:text-blue-400'
              }`}
            >
              Home
            </a>
            <div class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3">
              {
                CATEGORY_ORDER.map((category) => {
                  const categoryTools = tools.filter((tool) => tool.category === category);
                  if (categoryTools.length === 0) return null;

                  return (
                    <div>
                      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                        {category}
                      </p>
                      <ul class="space-y-1.5">
                        {categoryTools.map((tool) => (
                          <li>
                            <a
                              href={tool.href}
                              class={
                                currentPath === tool.href
                                  ? 'text-sm font-medium text-blue-700 dark:text-blue-400'
                                  : 'text-sm text-slate-600 hover:text-blue-700 dark:text-slate-400 dark:hover:text-blue-400'
                              }
                            >
                              {tool.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto max-w-4xl px-4 py-6 text-sm text-slate-500 dark:text-slate-400">
        <p>© {year} Box of Tools. Free online utilities. No signup, no tracking of your inputs.</p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>

    <script is:inline>
      const toolsMenuButton = document.getElementById('tools-menu-button');
      const toolsMenu = document.getElementById('tools-menu');

      function closeToolsMenu() {
        toolsMenu?.classList.add('hidden');
        toolsMenuButton?.setAttribute('aria-expanded', 'false');
      }

      toolsMenuButton?.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = !toolsMenu?.classList.contains('hidden');
        toolsMenu?.classList.toggle('hidden');
        toolsMenuButton.setAttribute('aria-expanded', String(!isOpen));
      });

      document.addEventListener('click', (event) => {
        if (toolsMenu && !toolsMenu.classList.contains('hidden') && !toolsMenu.contains(event.target) && event.target !== toolsMenuButton) {
          closeToolsMenu();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !toolsMenu?.classList.contains('hidden')) {
          closeToolsMenu();
          toolsMenuButton?.focus();
        }
      });
    </script>
  </body>
</html>
